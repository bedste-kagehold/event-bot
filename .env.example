# Discord Bot Token
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord Client ID
# Your application's client ID from the Discord Developer Portal
CLIENT_ID=your_client_id_here

# Discord Guild ID (Optional - for testing commands in a specific server)
# Right-click on your server and select "Copy Server ID" (requires Developer Mode enabled)
GUILD_ID=your_guild_id_here
